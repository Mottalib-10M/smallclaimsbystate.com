---
/**
 * Home (the pillar): the question, the answer with its range, the checker, three figures, the folded summary,
 * the six highest limits, how to read a limit, the state grid, then sections in accordions (text kept in the HTML).
 * Text: src/content/home.ts. Generated blocks carry data-chrome.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Body from './Body.astro';
import MiniSim from './calc/MiniSim';
import { HOME } from '../content/home';
import { route } from '../i18n/routes';
import { PAGES } from '../lib/pages';
import { helpers } from '../lib/helpers';
import { STATES, median, ranking, RETRIEVED } from '../lib/engine/claims';
import { usd, day } from '../lib/fmt';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map(([name, url]) => ({ name, url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const R = ranking();
const figures = [
  { v: usd(R[0].cap), l: `highest (${R[0].name}, ${R[1].name})` },
  { v: usd(median()), l: 'middle figure of the 50 states and DC' },
  { v: usd(R[R.length - 1].cap), l: `lowest (${R[R.length - 1].name})` },
];
const pageFor = (slug: string) => PAGES.find((p) => p.slug === `${slug}-small-claims-court`);
const guides = PAGES.filter((p) => p.group === 'guides');
const grid = [...STATES].sort((a, b) => a.name.localeCompare(b.name)).map((s) => ({ s, p: pageFor(s.slug) }));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources} faqOuverte={0}>
  <header class="mb-3">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-800 sm:text-lg" set:html={x.answer} />
  </header>
  <div id="calculator" data-outil data-chrome class="scroll-mt-20 [&_.rechner-mini]:mt-0"><MiniSim client:load kind="limit" title="Check your amount in your state" href={route('small-claims-court-limits', lang)} idPrefix="home" /></div>
  <p class="mt-3 text-sm text-navy-600">Independent site, not a law firm or a court · limits read on {day(RETRIEVED)} · <a href={route('method', lang)} class="underline">How we read the laws</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  <ul data-chrome class="my-6 grid gap-3 sm:grid-cols-3">
    {figures.map((f) => <li class="rounded-lg border border-navy-200 bg-white px-4 py-3"><p class="text-2xl font-bold text-navy-900">{f.v}</p><p class="text-sm text-navy-600">{f.l}</p></li>)}
  </ul>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="mb-6" />
  <section><Body html={x.start(h)} path={path} /></section>
  <section class="mt-6"><Body html={x.guide(h)} path={path} prefix="g" /></section>
  <section data-chrome class="mt-8">
    <h2 class="mb-3 text-2xl font-bold text-navy-900">Every state, one click</h2>
    <ul class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 lg:grid-cols-4">
      {grid.map(({ s, p }) => <li class="flex justify-between gap-2 border-b border-navy-100 py-1">{p ? <a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{s.name}</a> : <span class="text-navy-800">{s.name}</span>}<span class="tabular-nums text-right text-navy-600">{usd(s.cap)}{s.next && <span class="block text-xs">{usd(s.next.cap)} from {day(s.next.from)}</span>}</span></li>)}
    </ul>
    <p class="mt-2 text-sm text-navy-600">States in blue have their own page; every other limit, with its law, is on <a href={route('small-claims-court-limits', lang)} class="font-medium text-accent-700 underline">the full table</a>.</p>
    <p class="mt-3 text-sm text-navy-700">City page: <a href={route('los-angeles-small-claims-court', lang)} class="font-medium text-accent-700 underline">LA small claims court</a>, the Los Angeles Superior Court.</p>
  </section>
  <section data-chrome class="mt-8">
    <h2 class="mb-3 text-2xl font-bold text-navy-900">Suing in small claims: the guides</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {guides.map((p) => <li class="rounded-lg border border-navy-200 bg-white px-4 py-3"><a href={route(p.id, lang)} class="font-semibold text-accent-700 underline-offset-2 hover:underline">{p.nav}</a><p class="mt-1 text-sm text-navy-600">{p.card}</p></li>)}
    </ul>
  </section>
  <div class="mt-8 space-y-3">
    {x.folds.map((f) => (
      <details id={f.id} class="group rounded-lg border border-navy-200 bg-white">
        <summary class="cursor-pointer px-5 py-4 text-lg font-semibold text-navy-900">{f.title}</summary>
        <div class="px-5 pb-4"><Body html={f.html(h)} path={path} prefix={`f${f.id}`} /></div>
      </details>
    ))}
  </div>
</PageLayout>
