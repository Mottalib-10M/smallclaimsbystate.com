---
/** Embeddable page (iframe): the checker alone. noindex, outside the sitemap (astro.config). */
import '../../styles/global.css';
import MiniSim from '../../components/calc/MiniSim';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { RETRIEVED } from '../../lib/engine/claims';
import { day } from '../../lib/fmt';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Small claims limit checker by state (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><MiniSim client:load kind="limit" title="Does your claim fit the small claims limit?" idPrefix="embed" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · limits read on {day(RETRIEVED)} · not legal advice</p>
  </body>
</html>
