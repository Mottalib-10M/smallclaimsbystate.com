---
import PageLayout from '../../layouts/PageLayout.astro';
import { route } from '../../i18n/routes';
import { CONTACT_EMAIL } from '../../data/site-config';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to Small Claims By State about a small claims limit, a filing fee or a court that changed. E-mail only: no legal advice, nothing passed on to a lawyer or a firm.';
---
<PageLayout title="Contact Small Claims By State: report a limit that changed" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <article class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. There is no form and no phone line, and nothing you write is passed on to a lawyer, a law firm or anyone else.</p>
    <h2>What helps us most</h2>
    <ul>
      <li>A bill that changes a small claims limit, with its number and its link.</li>
      <li>A limit, a court name or a fee we read wrong: quote the statute, the rule or the court page that says otherwise.</li>
      <li>A statewide fee schedule we did not find.</li>
      <li>Embedding the checker on a library, legal aid or community page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not give legal advice, review a dispute, recommend a lawyer or file anything for you. The clerk of the court can explain the procedure, and a lawyer licensed in your state can advise on your case.</p>
  </article>
</PageLayout>
