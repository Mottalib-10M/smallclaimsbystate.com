---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/small-claims-calculator/" title="Small claims limit checker for the 50 states and DC" width="100%" height="700" style="border:0;max-width:900px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the small claims limit checker for 50 states and DC" description="Libraries, legal aid offices and community sites can embed the small claims limit checker, with the limit, court and fee of 51 jurisdictions, in one iframe line." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the checker', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the checker' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the small claims limit checker</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When we read a state’s law again, the embedded checker shows the new figure.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the checker visible, do not alter the frame, and do not place it next to a lawyer referral or lead form. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>Small claims limit checker</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/small-claims-calculator/" title="Small claims limit checker for the 50 states and DC" width="100%" height="700" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
